  "vector_memory": {
    "semantic_summary": "BrainHub is the central orchestration hub managing the lifecycle of loaded language models and session history. It coordinates model swapping via ModelOrchestrator, handles session persistence using HistoryManager, and controls system state via ProcessManager. Its core responsibility is ensuring the correct LLM is active, managing concurrency using internal locks, and enforcing state policies like 'wait', 'fail', or 'force' during model transitions."
  },
