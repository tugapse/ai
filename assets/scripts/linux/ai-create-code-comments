#!/usr/bin/env bash

# ==============================================================================
# File:        ai-create-code-comments
# Description: Automated Code Documentation Assistant
# Author:      Fábio Almeida
# Date:        2026-11-02
# Project:     Just A Reasoning Virtual Intelligent Sentinel Agentic Interface
# ==============================================================================
# Analyzes code files using AI to generate comments without altering the original
# logic. Ignores self-modifying executable scripts, writes directly to the file
# while preserving the inode, and supports review via nano.
# ==============================================================================



set -euo pipefail

COLOR_HEADER='\033[38;2;43;174;178m'
COLOR_SECTION='\033[38;2;79;168;227m'
COLOR_ARG='\033[38;2;54;188;175m'
COLOR_FLAG='\033[38;2;227;155;68m'
COLOR_ERR='\033[38;2;230;70;70m'
COLOR_MUTED='\033[38;2;90;105;120m'
COLOR_RESET='\033[0m'

SPINNER_PID=""
AI_PID=""
temp_file=""
err_file=""

show_help() {
    local script_name
    script_name="$(basename "$0")"

    echo -e "${COLOR_HEADER}AI CODE COMMENT GENERATOR HELP${COLOR_RESET}"
    echo -e "${COLOR_HEADER}--------------------------------------------------${COLOR_RESET}"
    echo -e "${COLOR_SECTION}Usage:${COLOR_RESET} ${script_name} [flags] <file>"
    echo ""
    echo -e "${COLOR_SECTION}Positional Arguments:${COLOR_RESET}"
    echo -e "  ${COLOR_ARG}<file>${COLOR_RESET}             Code file to document"
    echo ""
    echo -e "${COLOR_SECTION}Flags:${COLOR_RESET}"
    echo -e "  ${COLOR_FLAG}-y,  --yes${COLOR_RESET}          Accept changes without manual review"
    echo -e "  ${COLOR_FLAG}-s,  --silent${COLOR_RESET}       Suppress output and pass --no-out to the engine"
    echo -e "  ${COLOR_FLAG}-na, --no-animation${COLOR_RESET} Disable spinner animation"
    echo -e "  ${COLOR_FLAG}-h,  --help${COLOR_RESET}         Show this help menu"
    echo ""
}

cleanup() {
    if [[ -n "${SPINNER_PID:-}" ]] && kill -0 "$SPINNER_PID" 2>/dev/null; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
    fi

    if [[ -n "${AI_PID:-}" ]] && kill -0 "$AI_PID" 2>/dev/null; then
        kill -9 "$AI_PID" 2>/dev/null || true
        wait "$AI_PID" 2>/dev/null || true
    fi

    tput cnorm 2>/dev/null || true

    if [[ -n "${temp_file:-}" && -f "$temp_file" ]]; then
        rm -f "$temp_file"
    fi

    if [[ -n "${err_file:-}" && -f "$err_file" ]]; then
        rm -f "$err_file"
    fi
}

handle_abort() {
    cleanup
    echo -ne "\r\033[K"
    echo -e "${COLOR_ERR}\nOperation cancelled by the user.${COLOR_RESET}" >&2
    exit 130
}

trap handle_abort SIGINT SIGTERM
trap cleanup EXIT

spinner() {
    local target="$1"
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    tput civis 2>/dev/null || true

    while true; do
        for frame in "${frames[@]}"; do
            echo -ne "\r${COLOR_FLAG}${frame}${COLOR_RESET} ${COLOR_ARG}Reviewing file:${COLOR_RESET} ${target}..."
            sleep 0.08
        done
    done
}

open_editor() {
    local file_to_edit="$1"
    nano "$file_to_edit"
}

apply_file() {
    if cat "$temp_file" > "$target_file"; then
        echo -e "${COLOR_ARG}✔${COLOR_RESET} File '${target_file}' updated successfully."
        return 0
    else
        echo -e "\n${COLOR_ERR}✖${COLOR_RESET} Failed to write to the target file." >&2
        return 1
    fi
}

print_separator() {
    echo ""
    printf "${COLOR_MUTED}%s${COLOR_RESET}\n" "--------------------------------------------------"
    echo ""
}

auto_accept=false
silent_mode=false
no_animation=false
target_file=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -y|--yes)
            auto_accept=true
            shift
            ;;
        -s|--silent)
            silent_mode=true
            shift
            ;;
        -na|--no-animation)
            no_animation=true
            shift
            ;;
        -*)
            echo -e "${COLOR_ERR}Error:${COLOR_RESET} Unknown option '$1'." >&2
            show_help
            exit 1
            ;;
        *)
            if [[ -z "$target_file" ]]; then
                target_file="$1"
            else
                echo -e "${COLOR_ERR}Error:${COLOR_RESET} Unexpected argument '$1'." >&2
                exit 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$target_file" ]]; then
    echo -e "${COLOR_ERR}Error:${COLOR_RESET} No file specified." >&2
    show_help
    exit 1
fi

if [[ ! -f "$target_file" ]]; then
    echo -e "${COLOR_ERR}Error:${COLOR_RESET} File '${target_file}' not found." >&2
    exit 1
fi

target_file="$(realpath "$target_file")"
self_realpath="$(realpath "$0")"

# Previne auto-execução sobre o próprio runner
if [[ "$target_file" -ef "$self_realpath" ]]; then
    echo -e "${COLOR_FLAG}!${COLOR_RESET} Ignoring the script runner itself: ${COLOR_ARG}${target_file}${COLOR_RESET}"
    exit 0
fi

temp_file=$(mktemp) || {
    echo -e "${COLOR_ERR}Error:${COLOR_RESET} Failed to create temporary file." >&2
    exit 1
}

err_file=$(mktemp) || {
    echo -e "${COLOR_ERR}Error:${COLOR_RESET} Failed to create error log file." >&2
    exit 1
}

ai_cmd=(ai -f "$target_file" -t create-comment -o "$temp_file" --model "default")

if [[ "$silent_mode" == true ]]; then
    ai_cmd+=(--no-out)

    if [[ "$no_animation" == false ]]; then
        spinner "$target_file" &
        SPINNER_PID=$!
    else
        echo -e "${COLOR_ARG}Reviewing file:${COLOR_RESET} ${target_file}..."
    fi

    "${ai_cmd[@]}" >/dev/null 2>"$err_file" &
    AI_PID=$!

    ai_exit=0
    wait "$AI_PID" 2>/dev/null || ai_exit=$?
    AI_PID=""

    if [[ -n "${SPINNER_PID:-}" ]]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
        tput cnorm 2>/dev/null || true
        echo -ne "\r\033[K"
    fi

    if [[ $ai_exit -eq 130 ]]; then
        exit 130
    elif [[ $ai_exit -ne 0 ]]; then
        echo -e "${COLOR_ERR}Error:${COLOR_RESET} The AI command failed for ${target_file}." >&2
        if [[ -s "$err_file" ]]; then
            cat "$err_file" >&2
        fi
        exit 1
    fi
else
    echo "Generating comments with AI..."
    if ! "${ai_cmd[@]}"; then
        echo -e "${COLOR_ERR}Error:${COLOR_RESET} The AI command failed. Operation aborted." >&2
        exit 1
    fi
fi

if [[ ! -s "$temp_file" ]]; then
    echo -e "\n${COLOR_ERR}Error:${COLOR_RESET} The generated file is empty. Operation aborted." >&2
    exit 1
fi

if [[ "$auto_accept" == true ]]; then
    apply_file
elif [[ "$silent_mode" == true ]]; then
    open_editor "$temp_file"

    print_separator
    echo -e "${COLOR_HEADER}Review Completed${COLOR_RESET}"
    echo -e "Target file: ${COLOR_ARG}${target_file}${COLOR_RESET}"
    echo ""
    echo -ne "  ${COLOR_FLAG}?${COLOR_RESET} Apply changes to file? [y/N]: "
    read -r -n 1 confirm
    echo -e "\n"

    case "$confirm" in
        [yY])
            apply_file
            ;;
        *)
            echo -e "${COLOR_FLAG}!${COLOR_RESET} Aborted. Original file left unchanged."
            ;;
    esac
else
    print_separator
    echo -e "${COLOR_HEADER}Pending Changes Review${COLOR_RESET}"
    echo -e "Target: ${COLOR_ARG}${target_file}${COLOR_RESET}"
    echo ""
    echo -e "  [${COLOR_FLAG}s${COLOR_RESET}] Save directly to file"
    echo -e "  [${COLOR_FLAG}e${COLOR_RESET}] Edit generated draft before saving"
    echo -e "  [${COLOR_FLAG}c${COLOR_RESET}] Cancel and discard changes"
    echo ""
    echo -ne "Select action [s/e/C]: "
    read -r -n 1 action
    echo -e "\n"

    case "$action" in
        [sS])
            apply_file
            ;;
        [eE])
            open_editor "$temp_file"
            print_separator
            echo -e "Target: ${COLOR_ARG}${target_file}${COLOR_RESET}"
            echo ""
            echo -ne "  ${COLOR_FLAG}?${COLOR_RESET} Apply edited changes? [y/N]: "
            read -r -n 1 post_confirm
            echo -e "\n"
            case "$post_confirm" in
                [yY])
                    apply_file
                    ;;
                *)
                    echo -e "${COLOR_FLAG}!${COLOR_RESET} Aborted. Original file left unchanged."
                    ;;
            esac
            ;;
        *)
            echo -e "${COLOR_FLAG}!${COLOR_RESET} Aborted. Original file left unchanged."
            ;;
    esac
fi