{
  "name": "Cowboy Development Workflow",
  "description": "A high-fidelity multi-agent loop with strategic planning, technical scouting, and shell execution.",
  "entry_point": "MASTER",
  "max_iterations": 300,
  "agents": {
    "PLANNER": {
      "role": "labor",
      "prompt_file": "agents/multi/planner_helper.md",
      "tools": ["read_dir", "read_files", "smart_search", "send_notification"],
      "allowed_targets": ["USER", "MASTER"]
    },
    "MASTER": {
      "role": "management",
      "prompt_file": "agents/multi/master.md",
      "tools": ["send_notification","read_dir" , "read_files","read_file", "smart_search","web_search"],
      "allowed_targets": ["MASTER","ENGINEER", "SECRETARY", "USER", "STOP"]
    },
    "ENGINEER": {
      "role": "labor",
      "prompt_file": "agents/multi/engineer.md",
      "tools": ["read_file", "read_files", "write_file", "patch_file", "grep_file"],
      "allowed_targets": ["ENGINEER","MASTER", "SECRETARY", "USER"]
    },
    "SECRETARY": {
      "role": "labor",
      "prompt_file": "agents/multi/secretary.md",
      "tools": ["read_dir", "read_files", "read_file", "smart_search", "grep_file", "web_search", "web_read"],
      "allowed_targets": ["SECRETARY","MASTER"]
    },
    "SYSTEM_OPERATOR": {
      "role": "labor",
      "prompt_file": "agents/multi/operator.md",
      "tools": ["execute_command", "send_notification"],
      "allowed_targets": ["MASTER"]
    }
  }
}