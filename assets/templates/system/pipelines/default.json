{
  "name": "Single Agent workflow",
  "description": "A high-fidelity single-agent loop with strategic planning, technical scouting, and shell execution.",
  "entry_point": "MASTER",
  "max_iterations": 300,
  "agents": {
    "MASTER": {
      "role": "management",
      "prompt_file": "agents/default.md",
      "tools": [
        "read_dir",
        "smart_search",
        "read_file",
        "read_files",
        "write_file",
        "patch_file",
        "web_search",
        "web_read",
        "query_memory",
        "trigger_reflection",
        "execute_command",
        "grep_file",
        "delete_file",
        "send_notification",
        "search_knowledge",
        "get_component",
        "knowledge_neighbors",
        "find_symbol",
        "read_doc",
        "remember",
        "knowledge_status",
        "update_knowledge"
      ],
      "allowed_targets": [
        "MASTER",
        "USER"
      ]
    }
  }
}
